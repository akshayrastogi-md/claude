# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=AI Inventory Forecasting & Analytics
VERSION=1.0.0

# CORS
BACKEND_CORS_ORIGINS=["*"]

# Database
DATABASE_URL=sqlite:///./inventory_forecast.db
# For PostgreSQL: postgresql://user:password@localhost/dbname

# AI/ML Settings
FORECAST_HORIZON_DAYS=30
MIN_HISTORICAL_DAYS=30
CONFIDENCE_INTERVAL=0.95

# Model Settings
ENABLE_PROPHET=true
ENABLE_ARIMA=true
ENABLE_LSTM=true
ENABLE_XGBOOST=true

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ==================================
# PLATFORM INTEGRATIONS
# ==================================

# Shopify Integration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
SHOPIFY_REDIRECT_URI=https://yourapp.com/api/v1/integrations/oauth/callback/shopify

# WooCommerce Integration
# No API keys needed - users provide their own consumer key/secret

# Facebook Ads Integration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://yourapp.com/api/v1/integrations/oauth/callback/facebook

# Google Ads Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourapp.com/api/v1/integrations/oauth/callback/google
GOOGLE_DEVELOPER_TOKEN=your_google_ads_developer_token

# Shiprocket Integration
# No API keys needed - users provide their own email/password
