# ==================================
# ENVIRONMENT
# ==================================
ENVIRONMENT=development
DEBUG=false

# ==================================
# API SETTINGS
# ==================================
API_V1_STR=/api/v1
API_URL=http://localhost:8000
PROJECT_NAME=D2C Analytics & Forecasting Platform
VERSION=1.0.0
DESCRIPTION=Complete AI-powered analytics platform for D2C brands

# ==================================
# CORS (Comma-separated origins)
# ==================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://yourdomain.com"]

# ==================================
# POSTGRESQL DATABASE
# ==================================
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=d2c_analytics
POSTGRES_PORT=5432

# Constructed automatically from above
# DATABASE_URL=postgresql://postgres:password@localhost:5432/d2c_analytics

# ==================================
# MONGODB (Analytics & Logs)
# ==================================
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=d2c_analytics

# ==================================
# REDIS (Cache & Sessions)
# ==================================
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ==================================
# JWT AUTHENTICATION
# ==================================
# IMPORTANT: Generate a strong secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================================
# SECURITY
# ==================================
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60
API_KEY_HEADER=X-API-Key

# ==================================
# AI/ML FORECASTING
# ==================================
FORECAST_HORIZON_DAYS=30
MIN_HISTORICAL_DAYS=30
CONFIDENCE_INTERVAL=0.95

# Model Toggles
ENABLE_PROPHET=true
ENABLE_ARIMA=true
ENABLE_LSTM=true
ENABLE_XGBOOST=true

# ==================================
# SHOPIFY INTEGRATION
# ==================================
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# OAuth Scopes (comma-separated)
# SHOPIFY_SCOPES=read_orders,read_products,read_customers,read_inventory

# ==================================
# WOOCOMMERCE INTEGRATION
# ==================================
# No app-level API keys needed
# Users provide their own consumer key/secret per store

# ==================================
# FACEBOOK ADS INTEGRATION
# ==================================
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# OAuth Scopes
# FACEBOOK_SCOPES=ads_read,ads_management,business_management

# ==================================
# GOOGLE ADS INTEGRATION
# ==================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DEVELOPER_TOKEN=your_google_ads_developer_token

# ==================================
# SHIPROCKET INTEGRATION
# ==================================
# No app-level API keys needed
# Users provide their own email/password per store

# ==================================
# EMAIL NOTIFICATIONS (SMTP)
# ==================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=noreply@yourplatform.com
EMAILS_FROM_NAME=D2C Analytics Platform

# ==================================
# ERROR TRACKING (SENTRY)
# ==================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==================================
# LOGGING
# ==================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================================
# BACKGROUND WORKERS (CELERY)
# ==================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==================================
# SUBSCRIPTION TIER LIMITS
# ==================================
FREE_TIER_ORDER_LIMIT=100
STARTER_TIER_ORDER_LIMIT=1000
PRO_TIER_ORDER_LIMIT=10000

# ==================================
# FEATURE FLAGS
# ==================================
ENABLE_WEBHOOKS=true
ENABLE_ANALYTICS_CACHE=true
ENABLE_FORECAST_CACHE=true

# ==================================
# OAUTH REDIRECT URIs
# ==================================
# Update these with your actual domain in production
SHOPIFY_REDIRECT_URI=http://localhost:8000/api/v1/integrations/shopify/oauth/callback
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback/facebook
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/callback/google

# ==================================
# PRODUCTION NOTES
# ==================================
# 1. Generate strong SECRET_KEY: openssl rand -hex 32
# 2. Use environment-specific values for ENVIRONMENT (development/staging/production)
# 3. Set DEBUG=false in production
# 4. Use strong database passwords
# 5. Configure CORS origins properly (remove wildcard "*")
# 6. Set up Sentry for error tracking
# 7. Configure email SMTP for notifications
# 8. Use Redis persistence in production
# 9. Set up SSL/TLS certificates
# 10. Configure backup strategy for PostgreSQL and MongoDB
